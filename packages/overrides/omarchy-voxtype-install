#!/bin/bash

# omarchy:summary=Enable and configure VoxType dictation on OmixOS

set -euo pipefail

if ! command -v voxtype >/dev/null 2>&1; then
  echo "VoxType is not part of this OmixOS configuration." >&2
  echo "Enable programs.omarchy.dictation in the host configuration and rebuild first." >&2
  exit 2
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles"
mkdir -p "$state_dir"
rm -f "$state_dir/voxtype-disabled"

systemctl --user daemon-reload
systemctl --user start voxtype.service

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload >/dev/null
fi
omarchy-restart-shell || true
omarchy-notification-send -g  "VoxType Dictation Ready" \
  "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000 || true

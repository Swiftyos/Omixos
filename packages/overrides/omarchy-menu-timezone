#!/bin/bash

set -euo pipefail

timezone=${1:-}
if [[ -z $timezone ]]; then
  timezone=$(timedatectl list-timezones | omarchy-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
fi

if [[ ${OMIXOS_SYSTEM_DRY_RUN:-0} == 1 ]]; then
  echo "timezone=$timezone"
  exit 0
fi

if ! timedatectl list-timezones | grep -Fxq "$timezone"; then
  echo "Unknown timezone: $timezone" >&2
  exit 2
fi

sudo timedatectl set-timezone "$timezone"
omarchy-shell -q omarchy.clock refresh >/dev/null 2>&1 || true
omarchy-notification-send "Timezone is now set to $timezone"

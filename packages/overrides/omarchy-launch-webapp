#!/bin/bash

set -euo pipefail

if (( $# == 0 )); then
  echo "Usage: omarchy-launch-webapp <url> [browser arguments...]" >&2
  exit 1
fi

desktop_id="$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null || true)"
if [[ -z $desktop_id ]]; then
  desktop_id="$(xdg-mime query default x-scheme-handler/https 2>/dev/null || true)"
fi
desktop_id="${desktop_id:-chromium-browser.desktop}"

case "$desktop_id" in
  chromium-browser.desktop | chromium.desktop) browser_exec="chromium" ;;
  google-chrome.desktop) browser_exec="google-chrome-stable" ;;
  brave-browser.desktop) browser_exec="brave" ;;
  brave-origin.desktop) browser_exec="brave-origin" ;;
  microsoft-edge.desktop) browser_exec="microsoft-edge-stable" ;;
  *) browser_exec="chromium" ;;
esac

if ! command -v "$browser_exec" >/dev/null 2>&1; then
  echo "Cannot launch a web app: $browser_exec is not installed" >&2
  exit 1
fi

url="$1"
shift

browser_args=(--no-first-run)
if [[ ${OMIXOS_GRAPHICAL_TEST:-0} == 1 ]]; then
  # The AArch64 TCG acceptance VM has software rendering and no interactive
  # keyring unlock. Keep these concessions explicit and out of real sessions.
  browser_args+=(--disable-gpu --password-store=basic)
fi

# Launch the browser itself through the user manager. Keeping Chromium as the
# service's main process lets it survive gtk-launch's short-lived transient
# service without adding a second UWSM delegation layer.
systemd-run --user \
  --unit="omarchy-webapp-$(date +%s%N)" \
  --property=Type=exec \
  "$browser_exec" "${browser_args[@]}" --app="$url" "$@"

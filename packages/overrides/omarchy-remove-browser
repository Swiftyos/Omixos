#!/bin/bash

# omarchy:summary=Remove a browser installed through the OmixOS user profile
# omarchy:args=<chrome|brave|brave-origin|edge|firefox|zen>

set -euo pipefail

browser="${1:-}"
case "$browser" in
  chrome) package=google-chrome; desktop_id=google-chrome.desktop; flags_file="$HOME/.config/chrome-flags.conf" ;;
  edge) package=microsoft-edge-stable-bin; desktop_id=microsoft-edge.desktop; flags_file="$HOME/.config/microsoft-edge-stable-flags.conf" ;;
  brave) package=brave-bin; desktop_id=brave-browser.desktop; flags_file="$HOME/.config/brave-flags.conf" ;;
  brave-origin) package=brave-origin-bin; desktop_id=brave-origin.desktop; flags_file="$HOME/.config/brave-origin-flags.conf" ;;
  firefox) package=firefox; desktop_id=firefox.desktop; flags_file= ;;
  zen) package=zen-browser-bin; desktop_id=zen.desktop; flags_file= ;;
  *)
    echo "Usage: omarchy-remove-browser <chrome|brave|brave-origin|edge|firefox|zen>" >&2
    exit 1
    ;;
esac

current_browser="$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null || true)"
if [[ $current_browser == "$desktop_id" ]] && command -v chromium >/dev/null 2>&1; then
  env -u BROWSER xdg-settings set default-web-browser chromium-browser.desktop || true
fi

omarchy-pkg-drop "$package"
[[ -z $flags_file ]] || rm -f "$flags_file"
echo "$browser has been removed from the OmixOS user profile."

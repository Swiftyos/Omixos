#!/bin/bash

# omarchy:summary=Search pinned Nixpkgs and install packages into the user profile
# omarchy:args=[search-term]

set -euo pipefail

nixpkgs_ref="${OMIXOS_NIXPKGS_REF:-@nixpkgsRef@}"
nix_cli=(nix --extra-experimental-features "nix-command flakes")
query="${*:-}"

if [[ -z $query ]]; then
  query="$(gum input --prompt 'Search Nixpkgs> ' --placeholder 'application or package name')"
fi
[[ -n $query ]] || exit 0

search_results="$(mktemp "${TMPDIR:-/tmp}/omixos-nix-search.XXXXXX")"
search_errors="${search_results}.errors"
trap 'rm -f "$search_results" "$search_errors"' EXIT

echo "Searching the OmixOS-pinned Nixpkgs revision for: $query"
if ! NIXPKGS_ALLOW_UNFREE=1 "${nix_cli[@]}" --quiet search --impure --json "$nixpkgs_ref" "$query" 2>"$search_errors" |
  jq -r '
    to_entries[]
    | [
        (.key
          | sub("^legacyPackages\\.[^.]+\\."; "")
          | sub("^packages\\.[^.]+\\."; "")),
        (.value.pname // ""),
        (.value.description // "No description")
      ]
    | @tsv
  ' >"$search_results"; then
  cat "$search_errors" >&2
  echo "Nixpkgs search failed. Check the network connection and try again." >&2
  exit 2
fi

if [[ ! -s $search_results ]]; then
  echo "No packages matched '$query'."
  exit 1
fi

if [[ -n ${OMIXOS_PKG_INSTALL_SELECTION:-} ]]; then
  selection="$(awk -F '\t' -v attr="$OMIXOS_PKG_INSTALL_SELECTION" '$1 == attr { print; exit }' "$search_results")"
  if [[ -z $selection ]]; then
    echo "Requested Nix attribute '$OMIXOS_PKG_INSTALL_SELECTION' was not present in the search results." >&2
    exit 1
  fi
else
  selection="$(fzf --multi \
    --delimiter=$'\t' \
    --with-nth=1,3 \
    --preview 'printf "Nix attribute: %s\\n\\n%s\\n" {1} {3}' \
    --preview-window 'down:45%:wrap' \
    --bind 'alt-p:toggle-preview' \
    <"$search_results")"
fi

[[ -n $selection ]] || exit 0
while IFS=$'\t' read -r attr _pname _description; do
  [[ -n $attr ]] && omarchy-pkg-add "$attr"
done <<<"$selection"

if [[ -t 0 && -z ${OMIXOS_PKG_INSTALL_SELECTION:-} ]]; then
  omarchy-show-done
else
  echo "Package installation complete."
fi
